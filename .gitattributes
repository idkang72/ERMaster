# 기본: 텍스트 파일은 자동으로 줄바꿈 관리
* text=auto

# Java / 빌드 관련 소스 → LF 고정
*.java      text eol=lf
*.xml       text eol=lf
*.properties text eol=lf
*.MF        text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.exsd      text eol=lf
pom.xml     text eol=lf

# 바이너리 파일 → 변환 금지
*.jar       binary
*.xlsx      binary
*.png       binary
*.gif       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.db        binary
*.class     binary
*.zip       binary
